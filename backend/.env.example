# Servidor
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco de dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nomade
DB_PORT=3306

# CORS (origens separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500

# JWT — gere segredos longos e aleatórios (ex.: openssl rand -hex 64)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_DAYS=7

# Nível mínimo de nivel_acesso para papel "admin" (padrão: 100)
NIVEL_ADMIN=100

# Script seed:admin
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador
